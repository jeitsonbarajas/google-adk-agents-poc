# Archivo de ejemplo para variables de entorno
# Copia este archivo a .env y completa con tus valores

# ===========================================
# API KEYS (REQUERIDAS)
# ===========================================

# OpenAI API Key (REQUERIDO)
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google API Key para Gemini (OPCIONAL)
# Obtener en: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic Claude API Key (OPCIONAL)
# Obtener en: https://console.anthropic.com/
CLAUDE_API_KEY=sk-antxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# CONFIGURACIÓN DEL SERVIDOR
# ===========================================

# Puerto principal (8000 por defecto)
PORT=8000

# URL del adapter server (para desarrollo local)
ADAPTER_SERVER_URL=http://127.0.0.1:8001

# Puerto para ADK Web (8000 por defecto)
ADK_WEB_PORT=8000

# ===========================================
# CONFIGURACIÓN DE ENTORNO
# ===========================================

# Entorno de ejecución (development|production|railway|gcp|docker)
ENVIRONMENT=development

# Python path (automático en Docker)
PYTHONPATH=/app

# ===========================================
# CONFIGURACIONES OPCIONALES
# ===========================================

# Para Railway (automático)
# RAILWAY_ENVIRONMENT=production

# Para Google Cloud (automático)
# GOOGLE_CLOUD_PROJECT=tu-project-id

# Para depuración
# DEBUG=true
# LOG_LEVEL=debug

# ===========================================
# INSTRUCCIONES DE USO
# ===========================================

# 1. Copia este archivo:
#    cp .env.example .env

# 2. Configura al menos OPENAI_API_KEY

# 3. Para desarrollo local:
#    python agents-poc/main.py

# 4. Para despliegue:
#    - Railway: Configura variables en Railway Dashboard
#    - GCP: Usa Google Secret Manager
#    - Docker: Usa este archivo .env